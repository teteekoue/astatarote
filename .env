# Astatarote - Configuration d'environnement locale
# (En production : surcharger via les variables du conteneur, pas ce fichier)
DATABASE_URL=sqlite://///home/user/astatarote/astarote.db

# Sécurité — À CHANGER EN PRODUCTION
# ASTAROTE_SECRET_KEY=une-cle-longue-et-aleatoire
# ASTAROTE_TOKEN_EXPIRE_MINUTES=1440

# PHASE DE TEST — accès ouvert : compte démo partagé (admin/admin),
# connexion automatique via /api/auth/auto, et repli automatique sur ce
# compte quand aucune session valide n'est présentée (proxys, iframes,
# stockage bloqué). Passer à false et réactiver l'auth SaaS pour la mise
# en ligne publique.
ASTAROTE_BOOTSTRAP_ADMIN=true
ASTAROTE_OPEN_ACCESS=true
ASTAROTE_ADMIN_USERNAME=admin
ASTAROTE_ADMIN_PASSWORD=admin
ASTAROTE_ADMIN_EMAIL=admin@astarote.dev

# Optionnel : clés API LLM pour l'assistante Nemesis (sinon mode hors-ligne intégré)
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# FIREWORKS_API_KEY=
# COHERE_API_KEY=
# TOGETHER_API_KEY=
